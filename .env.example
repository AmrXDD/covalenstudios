# --- Supabase (server-side, used by app/lib/supabase.ts) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Supabase (client-side, exposed to the browser via window.ENV) ---
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# --- Public site metadata ---
PUBLIC_SITE_URL=https://covalenstudios.com

# --- Resend (transactional email for quote notifications) ---
# Get a key at https://resend.com/api-keys — never commit the real value.
RESEND_API_KEY=re_xxxxxxxxx
# Where new lead emails are delivered:
LEAD_NOTIFY_EMAIL=sales@covalenstudios.com
# Verified sender (must be on a domain you've verified in Resend).
# Until your domain is verified, you can use: CovalenStudios <onboarding@resend.dev>
LEAD_FROM_EMAIL=CovalenStudios <sales@covalenstudios.com>
